@@ -0,0 +1,53 @@
+package com.forestnote.app.notes
+
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import androidx.test.platform.app.InstrumentationRegistry
+import com.forestnote.core.format.NotebookRepository
+import com.forestnote.core.ink.Stroke
+import com.forestnote.core.ink.StrokePoint
+import com.forestnote.core.ink.BrushKind
+import kotlinx.coroutines.runBlocking
+import org.json.JSONObject
+import org.junit.Test
+
+/** Hosting-only instrumentation around the actual v2.0 repository and dependency. */
+class LegacyWriterSeedTest {
+    @Test fun seed()=runBlocking<Unit> {
+        val context=InstrumentationRegistry.getInstrumentation().targetContext
+        check(context.packageName=="com.forestnote.qualification")
+        val id=requireNotNull(InstrumentationRegistry.getArguments().getString("runId"))
+        require(Regex("[A-Za-z0-9_-]{1,40}").matches(id))
+        fun rows(name:String,sql:String):String = SQLiteDatabase.openDatabase(context.getDatabasePath(name).path,null,
+            SQLiteDatabase.OPEN_READONLY).use {db -> db.rawQuery(sql,null).use {c -> buildList {
+                while(c.moveToNext()) add((0 until c.columnCount).map {
+                    if(c.isNull(it)) null else if(c.getType(it)==android.database.Cursor.FIELD_TYPE_BLOB)
+                        "blob:"+android.util.Base64.encodeToString(c.getBlob(it),android.util.Base64.NO_WRAP) else c.getString(it)
+                })
+            }.toString() } }
+        for(mode in listOf("offline","joined")) {
+            val name="reader-qualification-${id}_$mode.db"
+            check(!context.getDatabasePath(name).exists()) {"Never overwrite a previous fixture"}
+            val repo=NotebookRepository.open(context,qualificationName=name)
+            val expected=JSONObject()
+            try {
+                repo.createNotebook("Historical v2.0 $mode")
+                if(mode=="joined") repo.enableSync()
+                val stroke=Stroke(points=listOf(StrokePoint(12,34,321,7),StrokePoint(56,78,654,8)))
+                repo.saveStroke(stroke)
+                if(mode=="joined") {
+                    val foreign=repo.pendingOps().first().copy(siteId="01ARZ3NDEKTSV4RRFFQ69G5FAV",opSeq=17,opTs=4_000_000_000_000L)
+                    repo.applySyncOps(listOf(foreign));repo.setSyncCursor(42)
+                }
+                expected.put("notebook",repo.currentNotebookId()).put("page",repo.currentPageId())
+                    .put("stroke",stroke.id).put("site",repo.syncSiteId() ?: JSONObject.NULL)
+            } finally {repo.close()}
+            expected.put("history",rows(name,"SELECT op_seq,tbl,pk,op_ts,cols FROM rhizome_outbox ORDER BY op_seq"))
+                .put("meta",rows(name,"SELECT tbl,pk,op_ts,op_seq,site_id FROM rhizome_row_meta ORDER BY tbl,pk"))
+                .put("strokeRows",rows(name,"SELECT * FROM stroke ORDER BY id"))
+                .put("version",rows(name,"PRAGMA user_version"))
+            check(context.getSharedPreferences("qualification_upgrade_evidence",Context.MODE_PRIVATE).edit()
+                .putString("${id}_$mode",expected.toString()).commit())
+        }
+    }
+}
