<?xml version="1.0" encoding="utf-8"?>
<!--
  One fixed-height row. WriterToolbarRow assigns widths and promotes overflow actions
  before controls become too small; the active drawing tool remains visible.
  The tool group is included from toolbar.xml (root id @id/toolbar) so ToolBar.kt
  still finds its buttons unchanged. A 1dp divider below this bar (in
  activity_main.xml) marks where the drawing surface begins.
-->
<com.forestnote.app.notes.WriterToolbarRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/writer_toolbar_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/white"
    android:elevation="0dp">

    <ImageButton
        android:id="@+id/btn_notebooks"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_library"
        android:scaleType="fitCenter"
        android:padding="5dp"
        android:contentDescription="@string/writer_library"
        android:background="@null" />

    <ImageButton
        android:id="@+id/btn_prev_page"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_arrow_left"
        android:contentDescription="@string/writer_previous"
        android:background="@null"
        android:scaleType="fitCenter"
        android:padding="5dp" />

    <TextView
        android:id="@+id/page_indicator"
        android:contentDescription="@string/writer_pages"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="0dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:text="1 / 1"
        android:textSize="@dimen/writer_toolbar_text"
        android:textColor="@color/black"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@null" />

    <ImageButton
        android:id="@+id/btn_next_page"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_arrow_right"
        android:contentDescription="@string/writer_next"
        android:background="@null"
        android:scaleType="fitCenter"
        android:padding="5dp" />

    <!-- Undo / redo (per-notebook history), grouped with the page arrows as history navigation. -->
    <ImageButton
        android:id="@+id/btn_undo"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_undo"
        android:contentDescription="@string/writer_undo"
        android:background="@null"
        android:scaleType="fitCenter"
        android:padding="5dp" />

    <ImageButton
        android:id="@+id/btn_redo"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_redo"
        android:contentDescription="@string/writer_redo"
        android:background="@null"
        android:scaleType="fitCenter"
        android:padding="5dp" />

    <ImageButton
        android:id="@+id/btn_viewport"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_viewport"
        android:contentDescription="@string/writer_viewport"
        android:background="@null"
        android:scaleType="fitCenter"
        android:padding="5dp" />

    <!-- Tool controls and the trailing More menu fill the remaining width. -->
    <include
        layout="@layout/toolbar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

</com.forestnote.app.notes.WriterToolbarRow>
